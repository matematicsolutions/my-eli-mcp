                }
              ],
              "default": null
            },
            "dataset_note": {
              "default": "lom.agc.gov.my (Laws of Malaysia Online) is the Attorney-General's Chambers' official portal for Malaysian federal legislation. This MVP covers principal Acts only, addressed by their numeric act coordinate (e.g. 883); amendments and subsidiary legislation (P.U. (A)/(B) notices) are not yet covered. Malaysia has no ELI scheme; eli_uri carries the durable lom.agc.gov.my act page URL (see eli_note).",
              "type": "string"
            },
            "eli_note": {
              "default": "Malaysia has not deployed ELI. eli_uri is the durable lom.agc.gov.my act page URL (https://lom.agc.gov.my/act-detail.php?language=BI&act={act_number}), keyed on the portal's own numeric act coordinate - never invented.",
              "type": "string"
            },
            "eli_uri": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "human_readable_citation": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "pdf_url": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "source_url": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "text_note": {
              "default": "Extracted from the official PDF with pypdf; minor layout artefacts (page numbers, column breaks) are possible.",
              "type": "string"
            },
            "title": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            }
          },
          "required": [
            "act_number"
          ],
          "type": "object"
        }
      },
      "sha256": "97036edfbb50194d1215ec8c04c7a1488251f18ba96fc0a88db972aa0510b3eb"
    }
  },
