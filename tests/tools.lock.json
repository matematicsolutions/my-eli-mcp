          },
          "required": [
            "act_number"
          ],
          "type": "object"
        },
        "meta": {
          "fastmcp": {
            "tags": []
          }
        },
        "name": "my_get_text",
        "outputSchema": {
          "additionalProperties": true,
          "description": "Result of ``my_get_text`` - the full text of an Act (extracted from its official PDF).",
          "properties": {
            "act_number": {
              "type": "integer"
            },
            "byte_size": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "content": {
              "anyOf": [
